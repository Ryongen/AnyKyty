layout(local_size_x = 64) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.a1) {
        return;
    }
    uint d = pc.a0 + i;
    uint64_t srt = xlate(DrawList(pc.arg).srt[d]);
    uint64_t tt = xlate(ld64(srt, 0u));
    uint64_t bt = xlate(ld64(srt, 2u));
    Words cw = Words(xlate(ld64(srt, 4u)));
    Words o = Words(pc.outp + uint64_t(d) * RSTRIDE);
    for (uint t = 0u; t < 16u; t++) {
        o.w[t] = (t < uint(KT)) ? lookup(ld64(tt, t * 8u), ld64(tt, t * 8u + 2u)) : 0u;
    }
    for (uint j = 0u; j < 8u; j++) {
        uint64_t a = (j < uint(KB)) ? xlate(ld64(bt, j * 4u)) : 0ul;
        uvec2 p = unpackUint2x32(a);
        o.w[16u + j * 2u] = p.x;
        o.w[17u + j * 2u] = p.y;
    }
    for (uint c = 0u; c < 64u; c++) {
        o.w[32u + c] = cw.w[c];
    }
}
